{
    "title": "Music",
    "id": "org.webosports.app.music",
    "version": "1.0.0",
    "vendor": "webOS Ports",
    "vendor_url": "https://github.com/webOS-ports/org.webosports.app.music",
    "type": "qml",
    "main": "qml/main.qml",
    "noWindow": true,
    "useWebEngine": false,
    "useLuneOSStyle": true,
    "icon": "icon.png",
    "splashicon": "icon-256x256.png",
    "uiRevision": "2",
    "exhibitionMode": true,
    "exhibitionModeOptions": { "title": "Now Playing" },
    "universalSearch": {
        "action": {
            "displayName": "Search Music",
            "launchParam": "search",
            "url": "org.webosports.app.music"
        },
        "dbsearch": {
            "displayName": "Songs",
            "url": "org.webosports.app.music",
            "launchParam": "target",
            "launchParamDbField": "path",
            "displayFields": [ "title", "artist" ],
            "dbQuery": {
                "from": "com.palm.media.audio.file:1",
                "where": [
                    { "prop": "isRingtone", "op": "=", "val": false },
                    { "prop": "searchKey", "op": "?", "val": "", "collate": "primary" }
                ],
                "limit": 20
            }
        }
    },
    "requiredPermissions": [ "accountsservice.operation", "application.launcher", "application.operation", "database.operation", "sleep.operation", "systemsettings.query", "notification.operation", "mediacontroller.query", "fmradio.operation" ],
    "mimeTypes": [
        { "mime": "audio/mpeg", "extension": "mp3", "stream": true },
        { "mime": "audio/mp4", "extension": "m4a", "stream": true },
        { "mime": "audio/x-m4a", "stream": true },
        { "mime": "audio/mp4", "extension": "m4b", "stream": true },
        { "mime": "audio/aac", "extension": "aac", "stream": true },
        { "mime": "audio/flac", "extension": "flac", "stream": true },
        { "mime": "audio/x-flac", "stream": true },
        { "mime": "audio/ogg", "extension": "ogg", "stream": true },
        { "mime": "audio/ogg", "extension": "oga", "stream": true },
        { "mime": "audio/opus", "extension": "opus", "stream": true },
        { "mime": "audio/x-wav", "extension": "wav", "stream": true },
        { "mime": "audio/wav", "stream": true },
        { "mime": "audio/x-ms-wma", "extension": "wma", "stream": true },
        { "mime": "audio/x-aiff", "extension": "aiff", "stream": true },
        { "mime": "audio/x-ape", "extension": "ape", "stream": true },
        { "mime": "audio/x-wavpack", "extension": "wv", "stream": true },
        { "mime": "audio/x-matroska", "extension": "mka", "stream": true },
        { "mime": "audio/x-mpegurl", "extension": "m3u", "stream": true },
        { "mime": "audio/mpegurl", "extension": "m3u8", "stream": true },
        { "mime": "audio/x-scpls", "extension": "pls", "stream": true },
        { "mime": "text/x-opml", "extension": "opml" }
    ],
    "keywords": [ "Music", "Music Player", "Songs", "Albums", "Artists", "Playlists", "Podcasts", "Audio", "MP3", "FLAC", "Player", "Now Playing" ]
}
